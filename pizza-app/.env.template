# Dash0 Configuration
# Get your token from: https://app.dash0.com → Settings → Auth Tokens

DASH0_AUTH_TOKEN=your_token_here

# Your Dash0 region endpoint
# Check your Dash0 URL to determine your region:
# - US West: https://ingress.us-west-2.aws.dash0.com:4317
# - EU West: https://ingress.eu-west-1.aws.dash0.com:4317
DASH0_ENDPOINT=https://ingress.us-west-2.aws.dash0.com:4317

# Which Dash0 dataset the telemetry lands in, and which environment it is
# tagged as. Both are optional.
DASH0_DATASET=default
DASH0_ENVIRONMENT=workshop

# Your fork of this repository. Sent as the vcs.repository.url.full resource
# attribute, which is how Dash0 links a service back to its source code.
VCS_REPOSITORY_URL=https://github.com/vincent3477/otel-pizza-workshop

# Browser monitoring (optional)
#
# The frontend is a static page, so whatever token it uses is visible to anyone
# who opens the page. Do NOT reuse DASH0_AUTH_TOKEN here. Create a second token
# scoped to Ingesting only, on the dataset above:
#   https://app.dash0.com → Settings → Auth Tokens
#
# Leave DASH0_WEB_AUTH_TOKEN empty and the frontend sends no telemetry; the
# three backend services are unaffected either way.
#
# DASH0_WEB_ENDPOINT is the OTLP over HTTP endpoint (no port, no /v1/... path),
# not the gRPC one above:
# - US West: https://ingress.us-west-2.aws.dash0.com
# - EU West: https://ingress.eu-west-1.aws.dash0.com
DASH0_WEB_AUTH_TOKEN=
DASH0_WEB_ENDPOINT=https://ingress.us-west-2.aws.dash0.com

# Optional: Enable debugging scenarios
SLOW_KITCHEN=false
NO_DRIVERS=false
ERROR_RATE=0
